    {"id": "policy_update_before_admission", "steps": ["Assess under revision 1.", "Commit restrictive revision 2.", "Attempt admission of old assessment."], "expected": "Reject stale admission; no tool execution."},
    {"id": "policy_update_after_admission", "steps": ["Admit call under revision 1.", "Commit revision 2.", "Dispatch admitted call within deadline."], "expected": "Already-admitted call may run; new calls use revision 2. Do not assert instantaneous retroactive cancellation."},
