  "lifecycle_cases": [
    {"id": "cache_hit_same_tenant", "steps": ["Compile supported policy.", "Create a second session with identical inputs in same tenant."], "expected": "Reuse validated compiled artifact; no second model compilation. Each session separately activates it."},
    {"id": "cache_changed_negation", "steps": ["Compile 'allow writes in development'.", "Change wording to 'do not allow writes in development'."], "expected": "Cache miss and separate compilation; no semantic text deduplication."},
    {"id": "cache_tenant_isolation", "steps": ["Compile in tenant A.", "Submit identical prose in tenant B."], "expected": "Tenant-scoped cache cannot expose tenant A's metadata or artifact."},
    {"id": "restart_no_recompile", "steps": ["Activate compiled session policy.", "Restart with an empty cache and changed compiler model."], "expected": "Restore stored active compiled result; no silent policy change."},
